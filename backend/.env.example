# TradeGuard Backend Environment Configuration Example
# Copy this file to .env and configure values before starting the application.
# NEVER commit real credentials to version control.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/tradeguard

# Authentication & Encryption
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
ENCRYPTION_KEY=your_aes_256_gcm_encryption_key_32_bytes_or_passphrase

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Password Reset & Email Notifications
EMAIL_USER=
EMAIL_PASS=
RESET_URL=http://localhost:3000/reset-password

# Supported Broker API Credentials (Write-only encrypted in database)
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/api/broker-accounts/upstox/callback

ANGEL_API_KEY=
ANGEL_CLIENT_ID=

DHAN_CLIENT_ID=
# Zerodha Kite Connect v3 API Credentials
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=http://localhost:5000/api/broker-accounts/zerodha/callback

# Groww Trading API Credentials
GROWW_API_KEY=
GROWW_API_SECRET=

# Note: Kotak Neo is deprecated for active integrations. Historical records are preserved.